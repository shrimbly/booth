# Read by app/scripts/release.sh; the environment wins over these.
#
# BOOTH_REPOSITORY: owner/name of the GitHub repository whose Releases host the disk image. The
#   Homebrew cask downloads
#   https://github.com/$BOOTH_REPOSITORY/releases/download/v<version>/Booth-<version>.dmg
# BOOTH_HOMEPAGE: the website (site/), for the cask's homepage. Defaults to the repository.
# BOOTH_TAP: owner/name of the Homebrew tap that `release.sh --publish` commits Casks/booth.rb to.
#   Homebrew finds owner/homebrew-booth as owner/booth: brew install --cask owner/booth/booth
BOOTH_REPOSITORY=shrimbly/booth
BOOTH_HOMEPAGE=https://getbooth.vercel.app
BOOTH_TAP=shrimbly/homebrew-booth
