# Read by app/scripts/release.sh. Fill these in once the repository exists on GitHub.
#
# BOOTH_REPOSITORY: owner/name of the GitHub repository whose Releases host the disk image, for
#   example acme/booth. The Homebrew cask downloads
#   https://github.com/$BOOTH_REPOSITORY/releases/download/v<version>/Booth-<version>.dmg
# BOOTH_HOMEPAGE: the website (site/), for the cask's homepage. Defaults to the repository.
BOOTH_REPOSITORY=shrimbly/booth
BOOTH_HOMEPAGE=
